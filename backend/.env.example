PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-frontend-domain.vercel.app

# Required in production (MongoDB Atlas recommended)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mykharcha?retryWrites=true&w=majority

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=30d
COOKIE_NAME=mykharcha_token

# Dev only
ALLOW_SEED_ENDPOINTS=false
