# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (if empty, backend may use in-memory MongoDB for local dev)
MONGODB_URI=

# Auth
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=30d
COOKIE_NAME=mykharcha_token

# Seed/dev controls (development only)
ALLOW_SEED_ENDPOINTS=true
